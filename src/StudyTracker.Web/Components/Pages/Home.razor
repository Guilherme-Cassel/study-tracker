@page "/"
@inherits StatusPageBase

<PageTitle>Painel · Study Tracker</PageTitle>

<StatusGate Result="Result" OnRetry="LoadAsync">
    @{
        var data = context;
        var block = data.CurrentBlock;
        var counts = block.CountByStatus();
        var next = block.NextSteps();
        var deadlines = block.UpcomingDeadlines();
        var gaps = block.MissingContext();
        var folderNotes = block.Items()
            .Select(i => (Item: i, Folder: Result!.FolderOf(i.Course, i.Assignment)))
            .Where(x => x.Folder.Suggestion is not null || x.Folder.Files.MisnamedDeliverables.Count > 0)
            .ToList();
    }

    <header class="page-head">
        <h1>Painel</h1>
        <p class="sub">
            <b>@block.Name</b> <span class="muted">[@block.Code]</span>
            · atualizado @Display.SinceText(data.UpdatedOn, Today)
        </p>
    </header>

    <nav class="tiles" aria-label="Trabalhos por status">
        @foreach (var status in Display.StatusesByPriority)
        {
            <a class="tile st-@status.Key()" href="trabalhos?status=@status.Key()">
                <span class="tile-n">@counts[status]</span>
                <span class="tile-l">@status.Label()</span>
            </a>
        }
    </nav>

    <div class="dash">
        <section class="card dash-main">
            <div class="card-head">
                <h2>Próximos passos</h2>
                <a href="trabalhos">ver todos</a>
            </div>
            @if (next.Count == 0)
            {
                <p class="empty">Nada em andamento. O que falta é contexto ou já foi entregue.</p>
            }
            else
            {
                <ul class="rows">
                    @foreach (var item in next.Take(6))
                    {
                        <li>
                            <a class="row" href="@Display.AssignmentUrl(item.Course, item.Assignment)">
                                <span class="row-id">@item.Course.Code <b>@item.Assignment.Id</b></span>
                                <span class="row-body">
                                    <StatusPill Status="item.Assignment.Status" />
                                    <span class="row-text clamp">@(item.Assignment.NextStep ?? item.Assignment.Summary ?? item.Course.Name)</span>
                                </span>
                                <DueText Assignment="item.Assignment" Today="Today" Compact="true" />
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>

        <div class="dash-side">
            @if (folderNotes.Count > 0)
            {
                <section class="card card-attention">
                    <div class="card-head"><h2>Pastas x painel</h2></div>
                    <ul class="rows compact">
                        @foreach (var (item, folder) in folderNotes)
                        {
                            <li>
                                <a class="row-note" href="@Display.AssignmentUrl(item.Course, item.Assignment)">
                                    <b>@item.Course.Code @item.Assignment.Id</b>
                                    <span>
                                        @if (folder.Suggestion is { } suggestion)
                                        {
                                            @Display.Describe(suggestion)
                                        }
                                        @if (folder.Files.MisnamedDeliverables.Count > 0)
                                        {
                                            <span class="warn-text">nome fora do padrão</span>
                                        }
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                </section>
            }
            <section class="card">
                <div class="card-head"><h2>Prazos</h2></div>
                @if (deadlines.Count == 0)
                {
                    <p class="empty">Nenhum prazo registrado.</p>
                }
                else
                {
                    <ul class="deadlines">
                        @foreach (var item in deadlines.Take(5))
                        {
                            var due = item.Assignment.DueOn!.Value;
                            var days = due.DaysUntil(Today);
                            <li class="@(days < 0 ? "late" : days <= 3 ? "soon" : "")">
                                <span class="dl-date">
                                    <b>@due.Day.ToString("00")</b>
                                    <small>@Display.MonthShort(due)</small>
                                </span>
                                <a href="@Display.AssignmentUrl(item.Course, item.Assignment)">@item.Course.Code @item.Assignment.Id</a>
                                <span class="dl-left">@Display.DueText(due, Today)</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="card">
                <div class="card-head"><h2>Falta contexto</h2></div>
                @if (gaps.Count == 0)
                {
                    <p class="empty">Todos os trabalhos têm enunciado e rubricas.</p>
                }
                else
                {
                    <p class="hint">Mandar enunciado e rubricas:</p>
                    <ul class="gaps">
                        @foreach (var gap in gaps)
                        {
                            <li>
                                <a href="@Display.CourseUrl(gap.Course)" class="code-chip">@gap.Course.Code</a>
                                <span>@string.Join(", ", gap.Assignments.Select(a => a.Id))</span>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>

    <section class="card">
        <div class="card-head">
            <h2>Disciplinas do bloco</h2>
            <a href="disciplinas">ver disciplinas</a>
        </div>
        <ul class="course-strip">
            @foreach (var (_, course) in block.Courses())
            {
                var progress = course.Progress();
                <li>
                    <a href="@Display.CourseUrl(course)">
                        <span class="code-chip">@course.Code</span>
                        <span class="cs-name">@course.Name</span>
                        <StatusBar Assignments="course.Assignments" />
                        <span class="cs-count">@progress.Submitted/@progress.Total</span>
                    </a>
                </li>
            }
        </ul>
    </section>

    <section class="card">
        <div class="card-head">
            <h2>Atividade recente</h2>
            <a href="historico">ver histórico</a>
        </div>
        <ul class="log">
            @foreach (var entry in data.History.Take(4))
            {
                <li><time>@Display.ShortDate(entry.Date)</time><span>@entry.Text</span></li>
            }
        </ul>
    </section>
</StatusGate>
