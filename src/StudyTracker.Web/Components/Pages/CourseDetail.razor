@page "/disciplinas/{Code}"
@inherits StatusPageBase
@inject Notifier Notifier

<StatusGate Result="Result" OnRetry="LoadAsync">
    @{
        var block = context.CurrentBlock;
        var found = block.FindCourse(Code);
    }

    @if (found is null)
    {
        <PageTitle>Disciplina não encontrada · Study Tracker</PageTitle>
        <header class="page-head">
            <h1>Disciplina não encontrada</h1>
            <p class="sub">Não existe @Code no bloco atual. <a href="disciplinas">Ver disciplinas</a></p>
        </header>
    }
    else
    {
        var (group, course) = found;
        var progress = course.Progress();
        var courseFolderExists = Result!.Folders.CourseExists(course);

        <PageTitle>@course.Code · Study Tracker</PageTitle>

        <p class="crumbs"><a href="disciplinas">Disciplinas</a> / @group.Title</p>
        <FileDrop Target="[block.Folder, course.Folder]" TargetLabel="@($"pasta da {course.Code}")" Context="courseInputId">
        <header class="page-head course-head">
            <span class="code-chip big">@course.Code</span>
            <div>
                <h1>@course.Name</h1>
                <p class="sub">
                    @if (!string.IsNullOrEmpty(course.Professor))
                    {
                        <span>Prof. @course.Professor · </span>
                    }
                    @progress.Submitted de @Display.Plural(progress.Total, "trabalho entregue", "trabalhos entregues")
                </p>
            </div>
            @if (courseFolderExists)
            {
                <OpenFolderButton Segments="[block.Folder, course.Folder]" Label="Pasta da disciplina" Class="head-action" />
            }
            else
            {
                <span class="muted head-action">pasta da disciplina não encontrada</span>
            }
        </header>
        </FileDrop>
        <StatusBar Assignments="course.Assignments" />

        <ol class="works">
            @foreach (var a in course.Assignments)
            {
                var open = a.Status != AssignmentStatus.Submitted;
                var folder = Result!.FolderOf(course, a);
                <li class="card work st-@a.Status.Key()" id="@a.Id">
                    <FileDrop Target="[block.Folder, course.Folder, a.Id]" TargetLabel="@($"{course.Code} / {a.Id}")" AssignmentId="@a.Id" Context="inputId">
                    <div class="work-head">
                        <h2>@a.Id</h2>
                        <StatusPill Status="a.Status" />
                        <DueText Assignment="a" Today="Today" />
                        <span class="head-action work-actions">
                            @if (folder.Folder.Exists)
                            {
                                <OpenFolderButton Segments="[block.Folder, course.Folder, a.Id]" />
                            }
                            <label class="btn btn-sm" for="@inputId" title="Ou arraste arquivos para cima deste trabalho">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4" /><path d="M7 9l5-5 5 5" /><path d="M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" /></svg>
                                Arquivos
                            </label>
                            @if (open)
                            {
                                <button type="button" class="btn btn-sm" @onclick="() => _rubrics = (course, a)">Colar rubricas</button>
                            }
                            <button type="button" class="btn btn-sm" @onclick="() => _editing = (course, a)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z" /><path d="M14 6l4 4" /></svg>
                                Editar
                            </button>
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(a.Summary))
                    {
                        <p class="work-summary">@a.Summary</p>
                    }
                    @if (open)
                    {
                        <StageChips Stages="a.Stages" />
                    }

                    <dl class="facts">
                        @if (open && !string.IsNullOrEmpty(a.NextStep))
                        {
                            <dt>Próximo passo</dt>
                            <dd>@a.NextStep</dd>
                        }
                        @if (!string.IsNullOrEmpty(a.Feedback))
                        {
                            <dt>Correção</dt>
                            <dd>@a.Feedback</dd>
                        }
                        @if (!string.IsNullOrEmpty(a.Notes))
                        {
                            <dt>Observação</dt>
                            <dd>@a.Notes</dd>
                        }
                        @if (!string.IsNullOrEmpty(a.GuideFile))
                        {
                            <dt>Guia</dt>
                            <dd><code>@a.GuideFile</code></dd>
                        }
                        @if (!folder.Folder.Exists)
                        {
                            <dt>Pasta</dt>
                            <dd class="muted">ainda não criada</dd>
                        }
                    </dl>

                    @if (folder.Suggestion is { } suggestion)
                    {
                        <div class="note note-suggest note-action">
                            <span><b>Pela pasta:</b> @Display.Describe(suggestion).</span>
                            <button type="button" class="btn btn-sm" disabled="@(_applying is not null)" @onclick="() => ApplyAsync(course, a)">
                                @(_applying == a ? "Aplicando…" : "Aplicar")
                            </button>
                        </div>
                    }
                    @if (folder.Files.MisnamedDeliverables.Count > 0)
                    {
                        <p class="note note-warn">
                            <b>Nome fora do padrão:</b> @string.Join(", ", folder.Files.MisnamedDeliverables).
                            O esperado é @FolderRules.DeliverableBaseName(Result.DeliverablePrefix!, course.Code, a.Id).&lt;ext&gt;
                        </p>
                    }
                    @if (folder.Folder.Entries.Count > 0)
                    {
                        <details class="files">
                            <summary>@Display.Plural(folder.Folder.Entries.Count, "item na pasta", "itens na pasta")</summary>
                            <ul>
                                @foreach (var entry in folder.Folder.Entries)
                                {
                                    <li class="@(entry.IsDirectory ? "is-dir" : "")">@entry.Name@(entry.IsDirectory ? "/" : "")</li>
                                }
                            </ul>
                        </details>
                    }
                    </FileDrop>
                </li>
            }
        </ol>
    }
</StatusGate>

@if (_rubrics is { } rubrics)
{
    <RubricsDialog Target="[Result!.Data!.CurrentBlock.Folder, rubrics.Course.Folder, rubrics.Assignment.Id]"
                   CourseCode="@rubrics.Course.Code" AssignmentId="@rubrics.Assignment.Id" OnClose="() => _rubrics = null" />
}

@if (_editing is { } editing)
{
    <AssignmentEditor Course="editing.Course" Assignment="editing.Assignment" OnClose="() => _editing = null" />
}

@code {
    [Parameter] public string Code { get; set; } = "";

    private (Course Course, Assignment Assignment)? _editing;
    private (Course Course, Assignment Assignment)? _rubrics;
    private Assignment? _applying;

    private async Task ApplyAsync(Course course, Assignment assignment)
    {
        _applying = assignment;
        var outcome = await State.ApplyFolderSuggestionAsync(course.Code, assignment.Id);
        _applying = null;

        switch (outcome.Status)
        {
            case SaveStatus.Saved:
                Notifier.Info($"{course.Code} {assignment.Id} acertado pela pasta.");
                break;
            case SaveStatus.NothingToDo:
                Notifier.Info("A pasta já bate com o painel.");
                break;
            case SaveStatus.Conflict:
                Notifier.Error("O arquivo mudou no instante da gravação. Tente de novo.");
                break;
            default:
                Notifier.Error("Não consegui gravar o status-dados.js. Confira se o Google Drive está aberto.");
                break;
        }
    }
}
