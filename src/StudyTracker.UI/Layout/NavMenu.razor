@inherits StatusPageBase

<aside class="sidebar">
    <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="var(--accent)" />
            <rect x="7" y="8" width="18" height="4" rx="2" fill="var(--on-accent)" opacity="0.95" />
            <rect x="7" y="14" width="13" height="4" rx="2" fill="var(--on-accent)" opacity="0.7" />
            <rect x="7" y="20" width="8" height="4" rx="2" fill="var(--on-accent)" opacity="0.45" />
        </svg>
        <span>Study Tracker</span>
    </a>

    <div class="sidebar-scroll">
        <nav class="nav" aria-label="Principal">
            <NavLink href="" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></svg>
                Painel
            </NavLink>
            <NavLink href="blocos">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="6" rx="1.5" /><rect x="3" y="14" width="18" height="6" rx="1.5" /></svg>
                Blocos
            </NavLink>
            <NavLink href="historico">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                Histórico
            </NavLink>
        </nav>

        @if (Result?.Data?.DefaultBlock is { IsDetailed: true } block)
        {
            <nav class="nav nav-courses" aria-label="Disciplinas do bloco atual">
                <a class="nav-title" href="@Display.BlockUrl(block)" title="@block.Name">@block.Name</a>
                @foreach (var (_, course) in block.Courses())
                {
                    <NavLink href="@Display.CourseUrl(block, course)" title="@course.Name">
                        <span class="code-chip">@course.Code</span>
                        <span class="nav-course-name">@course.Name</span>
                    </NavLink>
                }
            </nav>
        }
    </div>

    <div class="sidebar-foot">
        <ThemeSwitch />
        <span class="foot-path" title="@State.FolderPath">@State.FolderPath</span>
        <OpenFolderButton Segments="[]" Label="Abrir no Explorer" Class="btn-ghost" />
        <span class="foot-version">Study Tracker @AppInfo.Version</span>
    </div>
</aside>
