@if (Stages is not null)
{
    <ul class="stages" aria-label="Etapas">
        @foreach (var stage in Enum.GetValues<Stage>())
        {
            var done = Stages.Get(stage);
            <li class="stage @(done ? "done" : "")"><span aria-hidden="true">@(done ? "✓" : "○")</span> @stage.Label()</li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public Stages? Stages { get; set; }
}
